# Copy this file to .env and change only your local values.
MYSQL_DATABASE=stf
MYSQL_USER=stf_user
MYSQL_PASSWORD=stf_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306
REDIS_PORT=6379

# Spring Boot application settings.
# Docker Compose does not read these. Set them as environment variables of the
# application run configuration (for example in IntelliJ) or of the server.
# JWT_SECRET is required and must be at least 32 bytes (example: openssl rand -base64 48).
# TELEGRAM_BOT_USERNAME is the bot name without @. Signup fails until it is set.
#JWT_SECRET=
#TELEGRAM_BOT_USERNAME=
